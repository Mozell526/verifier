.gitignore
# macOS / Python artifacts
.DS_Store
__pycache__/
*.py[cod]

# .claude contents tracked by git (except these)
.claude/.DS_Store
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/bak/

# Runtime data
impl/data/context_runtime/
impl/data/context_store/
data/
*.xlsx
*.xls
report/
search-test-case/
issues/
issue/

# Project draft state (runtime-generated)
impl/projects/client_search/draft/.state/
impl/projects/client_search/start.sh
impl/projects/deerflow/draft/.state/
impl/projects/deerflow/draft/cases/mock_iteration*.json
impl/projects/deerflow/draft/investigation/mock/
impl/projects/deerflow/draft/probes/
impl/projects/deerflow/draft/mock.py
impl/projects/deerflow/draft/tools/mock_validation_tools.py
impl/projects/deerflow/mock_base.py
impl/projects/marketting-planning/draft/.state/
impl/projects/marketting-planning-intent/draft/.state/

# Playwright / codex / agent local artifacts
.playwright-cli/
.codex/
.agents/
.superpowers/
hooks/review/

# Other local-only files
*.backup
selenium_test*
/test_*.py
/_check_*.py
/_test_*.py
trace_mkdir.py
