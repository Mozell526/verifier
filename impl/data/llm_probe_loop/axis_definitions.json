                        "const": "not_found"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "citations": {
                        "maxItems": 0
                      },
                      "gap": {
                        "enum": [
                          "object_absent",
                          "item_absent"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          },
          "evidence": {
            "type": "array",
            "x-fill": "program"
          }
        },
        "required": [
          "items",
          "evidence"
        ],
        "additionalProperties": false
      },
      "checks": [
        {
          "refs_in": {
            "field": "item_id",
            "of": "params.items[].item_id",
            "on": "item"
          }
        },
        {
          "searched": {
            "field": "search_calls[]",
            "category": "knowledge",
            "on": "item"
          }
        },
        {
          "refs_in": {
            "field": "citations[].ref",
            "of": "own.search_calls[]",
            "on": "item"
          }
        },
        {
          "quote_in_call": {
